rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Orders Collection: Readable and writable for customer placing orders and cashier/admin
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && incoming().id == orderId;
      allow update: if isValidId(orderId);
      allow delete: if true;
    }

    // Cashier Shifts Collection: Handover and Shift auditing
    match /shifts/{shiftId} {
      allow read: if true;
      allow create: if isValidId(shiftId) && incoming().id == shiftId;
      allow update: if isValidId(shiftId);
      allow delete: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Global deny fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
